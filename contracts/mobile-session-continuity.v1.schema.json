{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:contract:atlas.mobile-session-continuity.v1",
  "title": "ATLAS Mobile same-profile session continuity V1",
  "oneOf": [
    {"$ref": "#/$defs/openRequest"},
    {"$ref": "#/$defs/ownerVerification"}
  ],
  "$defs": {
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$"
    },
    "openRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "profile_identity_authority", "session_authority", "profile_id", "session_id", "request_id"],
      "properties": {
        "contract": {"const": "atlas.mobile-session-continuity.v1"},
        "profile_identity_authority": {"const": "profile-service"},
        "session_authority": {"const": "hermes-profile-state"},
        "profile_id": {"$ref": "#/$defs/profileId"},
        "session_id": {"$ref": "#/$defs/sessionId"},
        "request_id": {"$ref": "#/$defs/requestId"}
      }
    },
    "ownerVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "profile_identity_authority", "session_authority", "profile_id", "session_id", "request_id", "verification_status", "verified_at", "expires_at"],
      "properties": {
        "contract": {"const": "atlas.hermes-session-verification.v1"},
        "profile_identity_authority": {"const": "profile-service"},
        "session_authority": {"const": "hermes-profile-state"},
        "profile_id": {"$ref": "#/$defs/profileId"},
        "session_id": {"$ref": "#/$defs/sessionId"},
        "request_id": {"$ref": "#/$defs/requestId"},
        "verification_status": {"const": "VERIFIED"},
        "verified_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  },
  "$comment": "A session identifier is a reference, never a bearer credential. Opening requires an exact, fresh Hermes owner verification bound to the selected server-owned Profile and a ProfileScopedSession loaded through that same owner adapter. JSON Schema expresses the structural boundary; validateMobileSessionContinuityPayload is mandatory for both variants and additionally enforces secret-marker rejection, calendar validity, and the maximum five-minute receipt lifetime. The contract carries no transcript, draft, scroll, typing, attachment, credential, device identity, or copied conversation state.",
  "x-atlas-application-validator": "validateMobileSessionContinuityPayload"
}
