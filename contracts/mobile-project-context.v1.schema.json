{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:contract:atlas.mobile-project-context.v1",
  "title": "ATLAS Mobile Project Context V1",
  "$comment": "Optional ATLAS enrichment for one native Hermes Project. Project Core and ProjectProjection remain separately shaped owner contracts; ProjectProjection.hermes_project_ref binds this enrichment to the upstream Hermes runtime Project. This contract is not a second Project catalog or identity. Cross-object identity equality, secret-free values and bounded provenance are enforced by MobileProjectContext.fromJson.",
  "x-atlas-application-validator": "MobileProjectContext.fromJson",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "project_identity_authority", "profile_identity_authority", "coordination_authority", "project_id", "profile_id", "name", "slug", "project_core", "project_projection"],
  "properties": {
    "contract": {"const": "atlas.mobile-project-context.v1"},
    "project_identity_authority": {"const": "document-service"},
    "profile_identity_authority": {"const": "profile-service"},
    "coordination_authority": {"const": "coordination-core"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "profile_id": {"$ref": "#/$defs/profileId"},
    "name": {"type": "string", "minLength": 1, "maxLength": 240},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"},
    "project_core": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "objective", "current_state", "current_focus", "open_questions", "revision", "updated_at", "updated_by", "provenance"],
          "properties": {
            "project_id": {"$ref": "#/$defs/uuid"},
            "objective": {"type": ["string", "null"], "minLength": 1, "maxLength": 8000},
            "current_state": {"type": ["string", "null"], "minLength": 1, "maxLength": 8000},
            "current_focus": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
            "open_questions": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
            "revision": {"type": "integer", "minimum": 1},
            "updated_at": {"$ref": "#/$defs/timestamp"},
            "updated_by": {"type": "string", "minLength": 2, "maxLength": 128},
            "provenance": {"type": "object", "maxProperties": 100}
          }
        }
      ]
    },
    "project_projection": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "profile_id", "continuity_status", "hermes_project_ref", "last_active_at", "revision", "updated_at", "provenance"],
          "properties": {
            "project_id": {"$ref": "#/$defs/uuid"},
            "profile_id": {"$ref": "#/$defs/profileId"},
            "continuity_status": {"enum": ["ACTIVE", "PAUSED"]},
            "hermes_project_ref": {"type": ["string", "null"], "pattern": "^hermes-project://[^\\s]{1,240}$"},
            "last_active_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
            "revision": {"type": "integer", "minimum": 1},
            "updated_at": {"$ref": "#/$defs/timestamp"},
            "provenance": {"$ref": "#/$defs/referenceProvenance"}
          }
        }
      ]
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "timestamp": {"type": "string", "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "referenceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changeset_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,63}$"},
        "source_ref": {"type": "string", "maxLength": 512, "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"},
        "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "actor_profile_id": {"$ref": "#/$defs/profileId"},
        "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s]+$"}
      }
    }
  }
}
